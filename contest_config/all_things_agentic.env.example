# All Things Agentic Cloud Run configuration.
# Copy values into each Cloud Run service; never commit credentials or tokens.

GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
KIRA_ALL_THINGS_GEMINI_MODEL=gemini-3.5-flash
KIRA_ALL_THINGS_IMAGE_MODEL=gemini-3.1-flash-image
# Required by both API and worker. Enter the bucket name without gs://.
# The bucket must have Public Access Prevention=enforced and Uniform
# Bucket-Level Access enabled; runtime startup rejects any other configuration.
KIRA_ALL_THINGS_ARTIFACTS_BUCKET=your-private-video-studio-artifacts-bucket

# Required by both roles for configuration consistency; used by the worker.
# Must name a Google Cloud Text-to-Speech Chirp 3 HD voice.
KIRA_ALL_THINGS_TTS_VOICE=en-US-Chirp3-HD-Aoede

# SHA-256 hex digest of the owner-created judge access code. The plaintext
# code is handed to judges out of band and is never stored in the service.
KIRA_ALL_THINGS_PROGRAM_ACCESS_SHA256=

KIRA_ALL_THINGS_FIRESTORE_DATABASE=(default)
KIRA_ALL_THINGS_JOBS_COLLECTION=all_things_agentic_jobs

KIRA_ALL_THINGS_TASKS_LOCATION=us-central1
KIRA_ALL_THINGS_TASKS_QUEUE=video-studio-production-briefs
KIRA_ALL_THINGS_WORKER_URL=https://your-private-worker-url.run.app
KIRA_ALL_THINGS_TASKS_SERVICE_ACCOUNT=video-studio-tasks@your-google-cloud-project-id.iam.gserviceaccount.com

# One shared judge gate: at most four new jobs per hour and exactly four
# concurrent active-job slots, with a ten-second cooldown. Slot acquisition is
# atomic with job creation/retry. Each job has at most three application
# attempts. Cloud Tasks delivery retries are separate crash recovery.
KIRA_ALL_THINGS_ADMISSION_COOLDOWN_SECONDS=10
KIRA_ALL_THINGS_ADMISSION_WINDOW_SECONDS=3600
KIRA_ALL_THINGS_ADMISSION_MAX_JOBS=4

# Reviewed project-wide image pacing and bounded provider-quota recovery.
KIRA_ALL_THINGS_VISUAL_PANELS_PER_DISPATCH=2
KIRA_ALL_THINGS_VISUAL_SUCCESSOR_DELAY_SECONDS=75
KIRA_ALL_THINGS_VISUAL_QUOTA_MAX_DEFERRALS=4
KIRA_ALL_THINGS_VISUAL_QUOTA_BASE_DEFERRAL_SECONDS=90
KIRA_ALL_THINGS_VISUAL_QUOTA_MAX_DEFERRAL_SECONDS=720

# The corrected dispatcher deadline and Cloud Run worker timeout are 1740s.
# Keep this lease longer so a stale delivery is fenced before reclaim.
KIRA_ALL_THINGS_WORKER_LEASE_SECONDS=1800

# Set to api on the public service and worker on the private service.
KIRA_ALL_THINGS_SERVICE_ROLE=api
PORT=8080
